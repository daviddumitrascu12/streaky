{
  "manifest_version": 3,
  "name": "Streaky",
  "version": "4.0.0",
  "description": "Streaky zählt deinen AMBOSS-Streak dauerhaft und synchronisiert ihn mit einem Supabase-Leaderboard.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.amboss.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.onrender.com/*",
    "https://*.railway.app/*",
    "https://*.up.railway.app/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amboss.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png",
        "assets/positive-streak/*.png",
        "assets/negative-streak/*.png"
      ],
      "matches": [
        "https://*.amboss.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Streaky",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Streaky"
}